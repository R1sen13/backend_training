NODE_ENV=development
PORT=3000

#DataBase (Your own postgresql credentials)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
DATABASE_URL=#postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}

#Redis (Your own redis credentials)
REDIS_URL=redis://localhost:6379

#S3-storage (Minio credentials)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=app-files
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me-password

